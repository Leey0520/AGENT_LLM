{
  "description": "Safe knowledge sync and credential protection for the game analytics wiki.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.mjs\"",
            "commandWindows": "node \"$((git rev-parse --show-toplevel).Trim())/.codex/hooks/session-start.mjs\"",
            "timeout": 30,
            "statusMessage": "正在安全同步知识库",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-tool-use.mjs\"",
            "commandWindows": "node \"$((git rev-parse --show-toplevel).Trim())/.codex/hooks/pre-tool-use.mjs\"",
            "timeout": 10,
            "statusMessage": "正在检查知识库安全边界"
          }
        ]
      }
    ]
  }
}
