{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.chilly.room/liyanzhun/llm_wiki/-/raw/main/schemas/knowledge-frontmatter.schema.json",
  "title": "Game analytics knowledge front matter",
  "type": "object",
  "required": [
    "id",
    "title",
    "scope",
    "status",
    "owner",
    "reviewed_at",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": ["platform", "method", "project"]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "approved", "retired"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "project"
          }
        },
        "required": ["scope"]
      },
      "then": {
        "required": ["project"]
      }
    }
  ],
  "additionalProperties": true
}
